rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // News Articles
    match /news/{articleId} {
      // Anyone can read published articles, but drafts only for admin
      allow read: if (resource.data.status == 'published') || isAdmin();
      
      // Only admin can write
      allow create, update, delete: if isAdmin();
      
      // Allow view count update for everyone (simple increment)
      // Note: In production, use increment() and tighten this
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']));
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']));
      allow delete: if isAdmin();
    }

    // Scraps
    match /scraps/{scrapId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
